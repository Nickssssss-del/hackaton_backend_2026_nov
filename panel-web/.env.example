# Copia este archivo como .env y llena los valores de tu proyecto de Supabase
# (Project Settings → API). Todo lo que empieza con VITE_ termina en el navegador:
# nunca pongas aquí contraseñas, la cadena postgresql:// ni la clave secreta.

# URL del proyecto, por ejemplo https://abcd1234.supabase.co
VITE_SUPABASE_URL=
# Clave publicable (sb_publishable_...). Nunca la secret key ni service_role.
VITE_SUPABASE_ANON_KEY=

# Opcional: "true" para mostrar los botones demo también en producción.
# Al desarrollar (npm run dev) siempre se muestran.
VITE_MOSTRAR_DEMO=
